// Path: src/ui/appwindow.slint
// Project: Gospelio Radio Player

import { Button, LineEdit, ListView, Slider, VerticalBox, HorizontalBox } from "std-widgets.slint";

// Тексти інтерфейсу. Заповнюються з Rust через i18n (файли src/locales/*/gospelio.ftl)
export global Tr {
    in property <string> app-title: "Gospelio";
    in property <string> stations-list: "Stations";
    in property <string> stop: "Stop";
    in property <string> volume: "Volume";
}

export struct StationItem {
    name: string,
}

// Головне вікно: список станцій, кнопка «Стоп», гучність, рядок стану
export component MainWindow inherits Window {
    title: Tr.app-title;
    preferred-width: 360px;
    preferred-height: 420px;
    min-width: 280px;
    min-height: 300px;

    in property <[StationItem]> stations;
    // Індекс станції, що зараз грає; -1 — нічого не грає
    in property <int> playing-index: -1;
    in property <string> status;
    // Гучність у відсотках (0..100) — цілі числа, без похибок f32
    in-out property <int> volume: 50;

    callback play-station(int);
    callback stop();
    // Викликається під час перетягування повзунка
    callback volume-changed(int);
    // Викликається, коли повзунок відпустили — тут зберігаємо конфіг
    callback volume-released(int);

    VerticalBox {
        Text {
            text: Tr.app-title;
            font-size: 18px;
            font-weight: 700;
        }

        Text {
            text: Tr.stations-list;
            color: #777;
        }

        ListView {
            vertical-stretch: 1;
            for station[i] in root.stations: Rectangle {
                height: 36px;
                border-radius: 4px;
                background: i == root.playing-index ? #3b82f633
                    : row-touch.has-hover ? #8881 : transparent;

                row-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.play-station(i); }
                }

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 8px;
                    Text {
                        text: i == root.playing-index ? "▶" : "";
                        width: 14px;
                        vertical-alignment: center;
                    }
                    Text {
                        text: station.name;
                        vertical-alignment: center;
                        overflow: elide;
                        font-weight: i == root.playing-index ? 700 : 400;
                    }
                }
            }
        }

        HorizontalBox {
            padding: 0px;
            Button {
                text: "⏹ " + Tr.stop;
                enabled: root.playing-index >= 0;
                clicked => { root.stop(); }
            }
            Text {
                text: Tr.volume + ": " + root.volume + "%";
                vertical-alignment: center;
                min-width: 110px;
            }
        }

        Slider {
            minimum: 0;
            maximum: 100;
            step: 1;
            value: root.volume;
            changed(v) => {
                root.volume = round(v);
                root.volume-changed(root.volume);
            }
            released(v) => { root.volume-released(root.volume); }
        }

        Text {
            text: root.status;
            color: #777;
            overflow: elide;
        }
    }
}

// Вікно вибору радіостанції або введення власного URL (Права кнопка миші)
export component StreamSelectorWindow inherits Window {
    title: "Gospelio — Вибір радіопотоку";
    width: 380px;
    height: 420px;
    always-on-top: true;

    callback add-stream(string);
    callback select-stream(int);

    VerticalBox {
        spacing: 10px;
        padding: 12px;

        Text {
            text: "Християнські радіостанції";
            font-size: 16px;
            font-weight: 700;
        }

        // Введення власного URL
        HorizontalBox {
            padding: 0px;
            spacing: 8px;
            
            input := LineEdit {
                placeholder-text: "https://stream.url/live";
            }
            Button {
                text: "Додати";
                clicked => {
                    if (input.text != "") {
                        root.add-stream(input.text);
                        input.text = "";
                    }
                }
            }
        }

        Text {
            text: "Доступні потоки:";
            font-size: 12px;
            color: #777;
        }

        // Тут у майбутньому буде список радіостанцій
    }
}

// Вікно налаштувань (Середня кнопка миші)
export component SettingsWindow inherits Window {
    title: "Gospelio — Налаштування";
    width: 320px;
    height: 220px;
    always-on-top: true;

    VerticalBox {
        padding: 16px;
        Text {
            text: "Параметри програвача";
            font-size: 16px;
            font-weight: 700;
        }
        Text {
            text: "• Автозапуск при вході в систему\n• Сповіщення про зміну треку\n• Керування гучністю колесом миші";
            font-size: 13px;
        }
    }
}
